# Source Brew PostgreSQL. Replace the password only in the ignored .env file.
PS_DATA_SOURCE_URI=postgresql://powersync_role:change-this-password@host.docker.internal:5432/timeapp

# PowerSync bucket storage PostgreSQL managed by the local Docker stack.
PS_STORAGE_DATABASE=powersync_storage
PS_STORAGE_PASSWORD=change-this-storage-password
PS_STORAGE_PORT=5433
PS_STORAGE_USER=postgres
PS_STORAGE_SOURCE_URI=postgresql://${PS_STORAGE_USER}:${PS_STORAGE_PASSWORD}@pg-storage:${PS_STORAGE_PORT}/${PS_STORAGE_DATABASE}
