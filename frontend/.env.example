# Android emulator talks to the host machine via 10.0.2.2
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# PowerSync development spike. The endpoint and token are separate from the
# TimeFlow API because PowerSync owns the downlink connection.
EXPO_PUBLIC_POWERSYNC_URL=
EXPO_PUBLIC_POWERSYNC_TOKEN=
# Set true only after the local PowerSync Service is running.
EXPO_PUBLIC_POWERSYNC_ENABLED=false
# One-shot local SQLite -> FastAPI upload verification. Never enable in production.
EXPO_PUBLIC_POWERSYNC_UPLOAD_SMOKE=false

# Baidu Maps browser-side AK with JavaScript API v4 enabled
EXPO_PUBLIC_BAIDU_MAP_AK=your-baidu-map-browser-ak

# Real backend WebSocket URL (required for release / production builds).
# The client appends its persisted device_id query parameter automatically.
# Local device example: ws://192.168.1.10:8000/ws
# Emulator example: ws://10.0.2.2:8000/ws/v1
# Production example: wss://api.example.com/ws
# Release builds require wss://. Plain ws:// is accepted only in development.

EXPO_PUBLIC_WS_URL=

# Explicit fake WebSocket opt-in when EXPO_PUBLIC_WS_URL is empty.
# Required for hosted web previews (`expo export` sets __DEV__=false).
# Do not set this on real production deploys.
# EXPO_PUBLIC_USE_FAKE_WS=true
